{
  "name": "ne-surf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "mkdir -p public/vendor/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/vendor/maplibre/",
    "ingest": "cd workers && .venv/bin/python -m nesurf.fetch_ww3 --source aws && .venv/bin/python -m nesurf.fetch_hrrr --res 0.05 && .venv/bin/python -m nesurf.fetch_ndbc && .venv/bin/python -m nesurf.fetch_tides && .venv/bin/python -m nesurf.calibrate",
    "bathy": "cd workers && .venv/bin/python -m nesurf.bathy",
    "verify:spots": "cd workers && .venv/bin/python -m nesurf.verify_spots",
    "diff": "node scripts/pixel-diff.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/extensions": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@types/d3-shape": "^3.2.0",
    "d3-shape": "^3.2.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/maplibre-gl": "^1.13.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
